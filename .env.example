# Ortak MySQL veritabanı (cv projesi de aynı adresi kullanır)
DATABASE_URL="mysql://redbunder:redbunder@localhost:3306/redbunder"

# Sitenin dış adresi – QR kodlar bu adrese göre üretilir
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Kariyer sitesi adresi (menüdeki "Kariyer" linki)
NEXT_PUBLIC_CAREER_URL="http://localhost:3001"

# Oturum imzalama anahtarı (en az 32 karakter):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Yüklenen görsellerin klasörü (proje köküne göre). /uploads/... adresinden sunulur.
UPLOAD_DIR="storage/uploads"

# `npm run db:seed` ile oluşturulacak ilk yönetici
SEED_ADMIN_EMAIL="admin@redbunder.com"
SEED_ADMIN_PASSWORD="degistir-beni"
